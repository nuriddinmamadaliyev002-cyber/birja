# Nusxa oling: .env nomi bilan saqlang (.env GitHub'ga yuklanmaydi)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/birja
PORT=3000
# Birinchi ishga tushirishda admin paroli (bo'sh qoldirsangiz tasodifiy parol konsolda chiqadi)
ADMIN_PASSWORD=
# HTTPS ortida ishlaganda 1
COOKIE_SECURE=0
# Bulut bazalari (Neon, Supabase, Railway) uchun SSL kerak bo'lsa 1
PGSSL=0
# Shartnoma PDF lari papkasi (bo'sh qoldirsangiz: ./data/uploads/my-lots)
UPLOAD_DIR=
